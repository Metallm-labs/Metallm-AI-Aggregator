# =============================================================================
# Metallm AI Aggregator — environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# =============================================================================

# --- Core (required) --------------------------------------------------------
NODE_ENV=development
PORT=5000

# Local Postgres. SSL is auto-disabled for localhost (see shared/db-ssl.ts);
# force it either way with DATABASE_SSL=true|false.
DATABASE_URL=postgresql://USER@localhost:5432/metallm

# Session cookie signing key — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public URLs used in emails, OAuth callbacks and payment redirects
APP_URL=http://localhost:5000
PUBLIC_APP_URL=http://localhost:5000
PUBLIC_BASE_URL=http://localhost:5000

# --- AI providers (optional — a provider only errors when actually called) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# AWS Bedrock
AWS_REGION=us-east-1
AWS_BEDROCK_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# Alternate key names read by the integrations layer
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GROK_API_KEY=

# --- Google OAuth (optional) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Email / SMTP (Zoho) — optional -----------------------------------------
ZOHO_USER=
ZOHO_APP_PASSWORD=
SUPPORT_EMAIL=
FEEDBACK_EMAIL=
PROMOTION_EMAIL=
WELCOME_EMAIL=

# --- Payments (optional) ----------------------------------------------------
# "paddle" (default), "lemonsqueezy" or "oxapay"
PAYMENT_PROVIDER=paddle

PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_YEARLY_VARIANT_ID=
LEMON_SQUEEZY_STARTER_VARIANT_ID=
LEMON_SQUEEZY_PRO_VARIANT_ID=
LEMON_SQUEEZY_ENTERPRISE_VARIANT_ID=

OXAPAY_ENVIRONMENT=sandbox
OXAPAY_MERCHANT_KEY=
OXAPAY_MERCHANT_KEY_SANDBOX=

# --- Qbitcoin wallet (optional) ---------------------------------------------
QBC_NODE_URL=
MAIN_WALLET_ADDRESS=
# Must be exactly 64 hex chars (32 bytes); wallet ops are disabled without it.
QBC_WALLET_ENCRYPTION_KEY=

# --- Admin panel (optional) -------------------------------------------------
ADMIN_PASSWORD=

# --- Business agent (optional) ----------------------------------------------
BUSINESS_AGENT_MODEL=
BUSINESS_AGENT_WORKSPACE_ROOT=

# --- Tuning (optional, sane defaults in code) -------------------------------
JSON_BODY_LIMIT=16mb
TRUST_PROXY=1
API_RATE_LIMIT_WINDOW_MS=
API_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=
AUTH_LOGIN_RATE_LIMIT_MAX=
AUTH_REGISTER_RATE_LIMIT_MAX=
AUTH_VERIFY_RATE_LIMIT_MAX=
AUTH_RESEND_OTP_RATE_LIMIT_MAX=
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX=
AUTH_RESET_PASSWORD_RATE_LIMIT_MAX=
